generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                   String              @id @db.Uuid
  isDemo               Boolean             @default(false) @map("is_demo")
  healthConsentVersion String?             @map("health_consent_version") @db.VarChar(32)
  healthConsentAt      DateTime?           @map("health_consent_at") @db.Timestamptz(6)
  purgeAfter           DateTime            @map("purge_after") @db.Timestamptz(6)
  createdAt            DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  sessions             Session[]
  assessments          Assessment[]
  subscription         Subscription?
  paymentEvents        PaymentEvent[]
  idempotencyRecords   IdempotencyRecord[]

  @@index([purgeAfter])
  @@map("users")
}

model Session {
  id        String    @id @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User      @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model Assessment {
  id                   String            @id @db.Uuid
  userId               String            @map("user_id") @db.Uuid
  sourceAssessmentId   String?           @map("source_assessment_id") @db.Uuid
  status               String            @default("DRAFT") @db.VarChar(16)
  revision             Int               @default(0)
  age                  Int?              @db.SmallInt
  sex                  String?           @db.VarChar(16)
  scopeVersion         String?           @map("scope_version") @db.VarChar(32)
  scopeConfirmedAt     DateTime?         @map("scope_confirmed_at") @db.Timestamptz(6)
  goal                 String?           @db.VarChar(24)
  heightCm             Decimal?          @map("height_cm") @db.Decimal(5, 1)
  weightKg             Decimal?          @map("weight_kg") @db.Decimal(5, 1)
  targetWeightKg       Decimal?          @map("target_weight_kg") @db.Decimal(5, 1)
  activityLevel        String?           @map("activity_level") @db.VarChar(24)
  questionnaireAnswers Json              @default("{}") @map("questionnaire_answers") @db.JsonB
  submittedAt          DateTime?         @map("submitted_at") @db.Timestamptz(6)
  createdAt            DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  user                 User              @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  sourceAssessment     Assessment?       @relation("AssessmentSource", fields: [sourceAssessmentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  derivedAssessments   Assessment[]      @relation("AssessmentSource")
  result               AssessmentResult?
  paymentEvents        PaymentEvent[]

  @@unique([id, userId])
  @@index([userId, createdAt(sort: Desc), id(sort: Desc)])
  @@map("assessments")
}

model AssessmentResult {
  id                  String     @id @db.Uuid
  assessmentId        String     @unique @map("assessment_id") @db.Uuid
  sourceRevision      Int        @map("source_revision")
  algorithmVersion    String     @map("algorithm_version") @db.VarChar(32)
  inputSnapshot       Json       @map("input_snapshot")
  calculationMetadata Json       @map("calculation_metadata")
  personalPlan        Json?      @map("personal_plan")
  bmi                 Decimal    @db.Decimal(6, 3)
  restingEnergyKcal   Int        @map("resting_energy_kcal")
  maintenanceKcal     Int        @map("maintenance_kcal")
  suggestedIntakeKcal Int        @map("suggested_intake_kcal")
  predictionStatus    String     @map("prediction_status") @db.VarChar(24)
  baseDate            DateTime   @map("base_date") @db.Date
  targetDate          DateTime?  @map("target_date") @db.Date
  durationDays        Int?       @map("duration_days")
  weeklyChangeKg      Decimal    @map("weekly_change_kg") @db.Decimal(4, 2)
  predictionCurve     Json       @map("prediction_curve")
  createdAt           DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  assessment          Assessment @relation(fields: [assessmentId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@map("assessment_results")
}

model RateLimitBucket {
  key         String   @id @db.VarChar(64)
  windowStart DateTime @map("window_start") @db.Timestamptz(6)
  count       Int
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("rate_limit_buckets")
}

model Subscription {
  id            String         @id @db.Uuid
  userId        String         @unique @map("user_id") @db.Uuid
  status        String         @default("INACTIVE") @db.VarChar(16)
  planCode      String?        @map("plan_code") @db.VarChar(32)
  startsAt      DateTime?      @map("starts_at") @db.Timestamptz(6)
  expiresAt     DateTime?      @map("expires_at") @db.Timestamptz(6)
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  user          User           @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  paymentEvents PaymentEvent[]

  @@unique([id, userId])
  @@map("subscriptions")
}

model PaymentEvent {
  id                String       @id @db.Uuid
  userId            String       @map("user_id") @db.Uuid
  assessmentId      String       @map("assessment_id") @db.Uuid
  subscriptionId    String       @map("subscription_id") @db.Uuid
  provider          String       @default("MOCK") @db.VarChar(16)
  eventId           String       @map("event_id") @db.Uuid
  requestHash       String       @map("request_hash") @db.Char(64)
  outcome           String       @db.VarChar(24)
  planCode          String       @default("DEMO_30D") @map("plan_code") @db.VarChar(32)
  observedStartsAt  DateTime     @map("observed_starts_at") @db.Timestamptz(6)
  observedExpiresAt DateTime     @map("observed_expires_at") @db.Timestamptz(6)
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  user              User         @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  assessment        Assessment   @relation(fields: [assessmentId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  subscription      Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([userId, provider, eventId])
  @@index([userId, createdAt])
  @@map("payment_events")
}

model IdempotencyRecord {
  id             String   @id @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  operation      String   @db.VarChar(200)
  key            String   @db.Uuid
  requestHash    String   @map("request_hash") @db.Char(64)
  responseStatus Int      @map("response_status") @db.SmallInt
  responseData   Json     @map("response_data")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user           User     @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([userId, operation, key])
  @@index([createdAt])
  @@map("idempotency_records")
}
